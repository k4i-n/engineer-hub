{
  "name": "engineer-hub",
  "version": "0.1.1",
  "private": true,
  "description": "Local work record for one engineer's tickets, written and read by coding agents through a compact CLI",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "hub": "src/cli.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "type-check": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "node --test 'test/*.test.ts'"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
